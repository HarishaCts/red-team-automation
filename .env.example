# Copy this file to `.env` and fill in values as needed.
# The framework runs in MOCK mode (no network calls) when ANTHROPIC_API_KEY is empty,
# so you can try the full pipeline before you have a key.

# Your Anthropic API key. Leave blank to force mock mode.
ANTHROPIC_API_KEY=

# Optional: override the default base URL (e.g. for a proxy or gateway).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: PostgreSQL DSN. If unset, the framework uses local SQLite.
# REDTEAM_DATABASE_URL=postgresql://user:pass@localhost:5432/redteam
